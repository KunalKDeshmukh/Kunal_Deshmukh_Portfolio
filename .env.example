# --- Frontend (build-time) ---
# Only needed if you're running the standalone /server backend locally.
# Leave unset in Vercel — the enquiry form posts to the same-origin
# /api/enquiry serverless function automatically.
VITE_API_URL=

# --- /api/enquiry serverless function (set these in Vercel Project Settings
# -> Environment Variables, not in this file) ---

# Where new enquiry notifications are sent (your inbox).
NOTIFY_EMAIL=1015kunaldeshmukh@gmail.com

# SMTP credentials used to send the notification + auto-reply emails.
# For Gmail: enable 2FA on the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that here (not your
# normal password). Without these set, the form still works (submissions
# succeed) but no emails are sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=1015kunaldeshmukh@gmail.com
SMTP_PASS=your-app-password-here
