# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API (your portfolio URL)
CORS_ORIGIN=http://localhost:5173

# Where new enquiry notifications are sent (your inbox)
NOTIFY_EMAIL=1015kunaldeshmukh@gmail.com

# SMTP credentials used to send the notification + auto-reply emails.
# For Gmail: enable 2FA on the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that here (not your
# normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=1015kunaldeshmukh@gmail.com
SMTP_PASS=your-app-password-here

# Optional: simple shared-secret to protect the /api/admin endpoints.
# Send it as "Authorization: Bearer <token>" from the admin dashboard.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: Cloudflare Turnstile secret key for stronger spam protection.
# Leave blank to rely on the honeypot + rate limiting only.
TURNSTILE_SECRET_KEY=
